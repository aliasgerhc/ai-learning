<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Disable directory browsing -->
        <directoryBrowse enabled="false" />
        
        <!-- Fix IIS blocking PUT, DELETE, and OPTIONS requests (often caused by WebDAV) -->
        <modules>
            <remove name="WebDAVModule" />
        </modules>
        <handlers>
            <remove name="WebDAV" />
        </handlers>

        <!-- Block direct access to database configuration -->
        <security>
            <requestFiltering>
                <filteringRules>
                    <filteringRule name="BlockConfig" scanUrl="true" scanQueryString="false">
                        <appliesTo>
                            <clear />
                        </appliesTo>
                        <denyStrings>
                            <add string="database.php" />
                        </denyStrings>
                    </filteringRule>
                </filteringRules>
                <!-- Alternatively, hide the entire config directory -->
                <hiddenSegments>
                    <add segment="config" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <!-- Ensure correct CORS headers are allowed -->
        <httpProtocol>
            <customHeaders>
                <!-- PHP will handle the actual CORS headers, but IIS shouldn't strip them -->
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
